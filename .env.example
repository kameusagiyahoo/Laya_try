# CPU-only Laya server. Keep the multilingual checkpoint resident.
LAYA_DEVICE=cpu
LAYA_MODELS=multilingual
LAYA_PRELOAD=1
LAYA_THREADS=4
LAYA_MAX_LOADED=1
# At most 4 requests may run or wait; excess requests receive HTTP 503.
LAYA_MAX_CONCURRENT=4

# Route low-confidence choices to the human skill.
LAYA_CONFIDENCE_THRESHOLD=0.70
# Voice Robot commands below this confidence are not applied.
LAYA_ROBOT_CONFIDENCE_THRESHOLD=0.80
# Robot sessions expire after inactivity. One controller lease is renewed by heartbeat.
LAYA_ROBOT_SESSION_TTL_SECONDS=3600
LAYA_ROBOT_LEASE_SECONDS=30
LAYA_ROBOT_MAX_SESSIONS=100
# Misclassification feedback is stored locally and ignored by Git.
LAYA_ROBOT_FEEDBACK_PATH=data/robot_feedback.jsonl

# Bind only to loopback; Tailscale Serve terminates private HTTPS.
LAYA_HOST=127.0.0.1
LAYA_PORT=8000

# Optional. Generate a long random value and never commit the populated .env.
# LAYA_API_KEY=replace-with-a-long-random-token

# Optional Hugging Face settings. The default cache is ~/.cache/huggingface/hub.
# HF_HOME=/path/to/persistent/huggingface-cache
# HF_TOKEN=
