# CPU-only Laya server. Keep the multilingual checkpoint resident.
LAYA_DEVICE=cpu
LAYA_MODELS=multilingual
LAYA_PRELOAD=1
LAYA_THREADS=4
LAYA_MAX_LOADED=1

# Route low-confidence choices to the human skill.
LAYA_CONFIDENCE_THRESHOLD=0.70

# Bind only to loopback; Tailscale Serve terminates private HTTPS.
LAYA_HOST=127.0.0.1
LAYA_PORT=8000

# Optional. Generate a long random value and never commit the populated .env.
# LAYA_API_KEY=replace-with-a-long-random-token

# Optional Hugging Face settings. The default cache is ~/.cache/huggingface/hub.
# HF_HOME=/path/to/persistent/huggingface-cache
# HF_TOKEN=
